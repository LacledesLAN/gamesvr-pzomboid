{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Linux - Build Docker Image",
            "type": "docker-build",
            "dockerBuild": {
                "context": "${workspaceFolder}",
                "dockerfile": "${workspaceFolder}/linux.Dockerfile",
                "tag": "gamesvr-pzomboid:latest",
                "pull": true
            },
            "problemMatcher": []
        },
        {
            "label": "Linux - Build & Execute Self Tests",
            "type": "shell",
            "command": "docker run -it --rm gamesvr-pzomboid:latest /app/ll-tests/gamesvr-pzomboid.sh;",
            "dependsOn": "Linux - Build Docker Image",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "promptOnClose": true
        },
        {
            "label": "Linux - Build & Shell In",
            "type": "shell",
            "command": "docker run -it --net=host gamesvr-pzomboid:latest /bin/bash",
            "dependsOn": "Linux - Build Docker Image",
            "group": "build",
            "problemMatcher": [],
            "promptOnClose": true
        }
    ]
}
